@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ap:   <https://fandaws.com/ontology/example/shapes/annotation-profile#> .

# Generated by tools/ontology/profile_shapes.py from config/annotation-profile.yaml -- do not edit.
#
# One property shape per annotation the project requires on every
# authored class, beyond the label and definition the wellformedness
# shapes already require.

ap:prefixes
    a owl:Ontology ;
    sh:declare
        [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .

ap:AuthoredClassProfileShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes ap:prefixes ;
        sh:select """SELECT ?this WHERE {
          ?this a owl:Class .
          FILTER(STRSTARTS(STR(?this), "https://fandaws.com/ontology/example#"))
        }""" ] ;

    # definition source
    sh:property [
        sh:path <https://www.commoncoreontologies.org/ont00001754> ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Class has no definition source. CCO cites the source of each definition with this annotation; a definition that says where it came from can be checked against it." ] .
