obo:BFO_0000001 <http://purl.org/dc/elements/1.1/identifier> "001-BFO" .
obo:BFO_0000001 rdf:type owl:Class .
obo:BFO_0000001 rdfs:label "entity"@en .
obo:BFO_0000001 skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en .
obo:BFO_0000001 skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en .

obo:BFO_0000002 <http://purl.org/dc/elements/1.1/identifier> "008-BFO" .
obo:BFO_0000002 owl:disjointWith obo:BFO_0000003 .
obo:BFO_0000002 rdf:type owl:Class .
obo:BFO_0000002 rdfs:label "continuant"@en .
obo:BFO_0000002 rdfs:subClassOf obo:BFO_0000001 .
obo:BFO_0000002 skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en .
obo:BFO_0000002 skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .

obo:BFO_0000003 <http://purl.org/dc/elements/1.1/identifier> "077-BFO" .
obo:BFO_0000003 rdf:type owl:Class .
obo:BFO_0000003 rdfs:label "occurrent"@en .
obo:BFO_0000003 rdfs:subClassOf obo:BFO_0000001 .
obo:BFO_0000003 skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en .
obo:BFO_0000003 skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .

obo:BFO_0000004 <http://purl.org/dc/elements/1.1/identifier> "017-BFO" .
obo:BFO_0000004 rdf:type owl:Class .
obo:BFO_0000004 rdfs:label "independent continuant"@en .
obo:BFO_0000004 rdfs:subClassOf obo:BFO_0000002 .
obo:BFO_0000004 skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en .
obo:BFO_0000004 skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .

obo:BFO_0000006 <http://purl.org/dc/elements/1.1/identifier> "035-BFO" .
obo:BFO_0000006 rdf:type owl:Class .
obo:BFO_0000006 rdfs:label "spatial region"@en .
obo:BFO_0000006 rdfs:subClassOf obo:BFO_0000141 .
obo:BFO_0000006 skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en .
obo:BFO_0000006 skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .

obo:BFO_0000008 <http://purl.org/dc/elements/1.1/identifier> "100-BFO" .
obo:BFO_0000008 rdf:type owl:Class .
obo:BFO_0000008 rdfs:label "temporal region"@en .
obo:BFO_0000008 rdfs:subClassOf obo:BFO_0000003 .
obo:BFO_0000008 skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en .
obo:BFO_0000008 skos:example "As for zero-dimensional temporal region and one-dimensional temporal region"@en .

obo:BFO_0000009 <http://purl.org/dc/elements/1.1/identifier> "039-BFO" .
obo:BFO_0000009 rdf:type owl:Class .
obo:BFO_0000009 rdfs:label "two-dimensional spatial region"@en .
obo:BFO_0000009 rdfs:subClassOf obo:BFO_0000006 .
obo:BFO_0000009 skos:definition "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts"@en .
obo:BFO_0000009 skos:example "The surface of a sphere-shaped part of space; an infinitely thin plane in space"@en .

obo:BFO_0000011 <http://purl.org/dc/elements/1.1/identifier> "095-BFO" .
obo:BFO_0000011 rdf:type owl:Class .
obo:BFO_0000011 rdfs:label "spatiotemporal region"@en .
obo:BFO_0000011 rdfs:subClassOf obo:BFO_0000003 .
obo:BFO_0000011 skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en .
obo:BFO_0000011 skos:example "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en .
obo:BFO_0000011 skos:scopeNote "'Spacetime' here refers to the maximal instance of the universal spatiotemporal region."@en .

obo:BFO_0000015 <http://purl.org/dc/elements/1.1/identifier> "083-BFO" .
obo:BFO_0000015 rdf:type owl:Class .
obo:BFO_0000015 rdfs:label "process"@en .
obo:BFO_0000015 rdfs:subClassOf obo:BFO_0000003 .
obo:BFO_0000015 skos:altLabel "event"@en .
obo:BFO_0000015 skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en .
obo:BFO_0000015 skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .

obo:BFO_0000016 <http://purl.org/dc/elements/1.1/identifier> "062-BFO" .
obo:BFO_0000016 owl:disjointWith obo:BFO_0000023 .
obo:BFO_0000016 rdf:type owl:Class .
obo:BFO_0000016 rdfs:label "disposition"@en .
obo:BFO_0000016 rdfs:subClassOf obo:BFO_0000017 .
obo:BFO_0000016 skos:altLabel "internally-grounded realizable entity"@en .
obo:BFO_0000016 skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en .
obo:BFO_0000016 skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en .

obo:BFO_0000017 <http://purl.org/dc/elements/1.1/identifier> "058-BFO" .
obo:BFO_0000017 owl:disjointWith obo:BFO_0000019 .
obo:BFO_0000017 rdf:type owl:Class .
obo:BFO_0000017 rdfs:label "realizable entity"@en .
obo:BFO_0000017 rdfs:subClassOf obo:BFO_0000020 .
obo:BFO_0000017 skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en .
obo:BFO_0000017 skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .

obo:BFO_0000018 <http://purl.org/dc/elements/1.1/identifier> "037-BFO" .
obo:BFO_0000018 rdf:type owl:Class .
obo:BFO_0000018 rdfs:label "zero-dimensional spatial region"@en .
obo:BFO_0000018 rdfs:subClassOf obo:BFO_0000006 .
obo:BFO_0000018 skos:definition "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space"@en .
obo:BFO_0000018 skos:example "The spatial region occupied at some time instant by the North Pole"@en .

obo:BFO_0000019 <http://purl.org/dc/elements/1.1/identifier> "055-BFO" .
obo:BFO_0000019 rdf:type owl:Class .
obo:BFO_0000019 rdfs:label "quality"@en .
obo:BFO_0000019 rdfs:subClassOf obo:BFO_0000020 .
obo:BFO_0000019 skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en .
obo:BFO_0000019 skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .

obo:BFO_0000020 <http://purl.org/dc/elements/1.1/identifier> "050-BFO" .
obo:BFO_0000020 rdf:type owl:Class .
obo:BFO_0000020 rdfs:label "specifically dependent continuant"@en .
obo:BFO_0000020 rdfs:subClassOf obo:BFO_0000002 .
obo:BFO_0000020 skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en .
obo:BFO_0000020 skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en .
obo:BFO_0000020 skos:example "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .

obo:BFO_0000023 <http://purl.org/dc/elements/1.1/identifier> "061-BFO" .
obo:BFO_0000023 rdf:type owl:Class .
obo:BFO_0000023 rdfs:label "role"@en .
obo:BFO_0000023 rdfs:subClassOf obo:BFO_0000017 .
obo:BFO_0000023 skos:altLabel "externally-grounded realizable entity"@en .
obo:BFO_0000023 skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en .
obo:BFO_0000023 skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .

obo:BFO_0000024 <http://purl.org/dc/elements/1.1/identifier> "027-BFO" .
obo:BFO_0000024 rdf:type owl:Class .
obo:BFO_0000024 rdfs:label "fiat object part"@en .
obo:BFO_0000024 rdfs:subClassOf obo:BFO_0000040 .
obo:BFO_0000024 skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en .
obo:BFO_0000024 skos:example "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body"@en .

obo:BFO_0000026 <http://purl.org/dc/elements/1.1/identifier> "038-BFO" .
obo:BFO_0000026 rdf:type owl:Class .
obo:BFO_0000026 rdfs:label "one-dimensional spatial region"@en .
obo:BFO_0000026 rdfs:subClassOf obo:BFO_0000006 .
obo:BFO_0000026 skos:definition "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts"@en .
obo:BFO_0000026 skos:example "An edge of a cube-shaped portion of space; a line connecting two points; two parallel lines extended in space"@en .

obo:BFO_0000027 <http://purl.org/dc/elements/1.1/identifier> "025-BFO" .
obo:BFO_0000027 rdf:type owl:Class .
obo:BFO_0000027 rdfs:label "object aggregate"@en .
obo:BFO_0000027 rdfs:subClassOf obo:BFO_0000040 .
obo:BFO_0000027 skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en .
obo:BFO_0000027 skos:example "The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank"@en .
obo:BFO_0000027 skos:scopeNote "'Exactly' means that there are no parts of the object aggregate other than its member parts." .
obo:BFO_0000027 skos:scopeNote "The unit can, at certain times, consist of exactly one object, for example, when a wolf litter loses all but one of its pups, but it must at some time have a plurality of member parts." .

obo:BFO_0000028 <http://purl.org/dc/elements/1.1/identifier> "040-BFO" .
obo:BFO_0000028 rdf:type owl:Class .
obo:BFO_0000028 rdfs:label "three-dimensional spatial region"@en .
obo:BFO_0000028 rdfs:subClassOf obo:BFO_0000006 .
obo:BFO_0000028 skos:definition "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts"@en .
obo:BFO_0000028 skos:example "A cube-shaped region of space; a sphere-shaped region of space; the region of space occupied by all and only the planets in the solar system at some point in time"@en .

obo:BFO_0000029 <http://purl.org/dc/elements/1.1/identifier> "034-BFO" .
obo:BFO_0000029 rdf:type owl:Class .
obo:BFO_0000029 rdfs:label "site"@en .
obo:BFO_0000029 rdfs:subClassOf obo:BFO_0000141 .
obo:BFO_0000029 skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en .
obo:BFO_0000029 skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en .

obo:BFO_0000030 <http://purl.org/dc/elements/1.1/identifier> "024-BFO" .
obo:BFO_0000030 rdf:type owl:Class .
obo:BFO_0000030 rdfs:label "object"@en .
obo:BFO_0000030 rdfs:subClassOf obo:BFO_0000040 .
obo:BFO_0000030 skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en .
obo:BFO_0000030 skos:example "An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube"@en .
obo:BFO_0000030 skos:scopeNote "A description of three primary sorts of causal unity is provided in Basic Formal Ontology 2.0. Specification and User Guide"@en .

obo:BFO_0000031 <http://purl.org/dc/elements/1.1/identifier> "074-BFO" .
obo:BFO_0000031 rdf:type owl:Class .
obo:BFO_0000031 rdfs:label "generically dependent continuant"@en .
obo:BFO_0000031 rdfs:subClassOf obo:BFO_0000002 .
obo:BFO_0000031 skos:altLabel "g-dependent continuant"@en .
obo:BFO_0000031 skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en .
obo:BFO_0000031 skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en .

obo:BFO_0000034 <http://purl.org/dc/elements/1.1/identifier> "064-BFO" .
obo:BFO_0000034 rdf:type owl:Class .
obo:BFO_0000034 rdfs:label "function"@en .
obo:BFO_0000034 rdfs:subClassOf obo:BFO_0000016 .
obo:BFO_0000034 skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en .
obo:BFO_0000034 skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en .

obo:BFO_0000035 <http://purl.org/dc/elements/1.1/identifier> "084-BFO" .
obo:BFO_0000035 rdf:type owl:Class .
obo:BFO_0000035 rdfs:label "process boundary"@en .
obo:BFO_0000035 rdfs:subClassOf obo:BFO_0000003 .
obo:BFO_0000035 skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en .
obo:BFO_0000035 skos:example "The boundary between the 2nd and 3rd year of your life"@en .

obo:BFO_0000038 <http://purl.org/dc/elements/1.1/identifier> "103-BFO" .
obo:BFO_0000038 owl:disjointWith obo:BFO_0000148 .
obo:BFO_0000038 rdf:type owl:Class .
obo:BFO_0000038 rdfs:label "one-dimensional temporal region"@en .
obo:BFO_0000038 rdfs:subClassOf obo:BFO_0000008 .
obo:BFO_0000038 skos:definition "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts"@en .
obo:BFO_0000038 skos:example "The temporal region during which a process occurs"@en .

obo:BFO_0000040 <http://purl.org/dc/elements/1.1/identifier> "019-BFO" .
obo:BFO_0000040 owl:disjointWith obo:BFO_0000141 .
obo:BFO_0000040 rdf:type owl:Class .
obo:BFO_0000040 rdfs:label "material entity"@en .
obo:BFO_0000040 rdfs:subClassOf obo:BFO_0000004 .
obo:BFO_0000040 skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .
obo:BFO_0000040 skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en .

obo:BFO_0000054 <http://purl.org/dc/elements/1.1/identifier> "206-BFO" .
obo:BFO_0000054 owl:inverseOf obo:BFO_0000055 .
obo:BFO_0000054 rdf:type owl:ObjectProperty .
obo:BFO_0000054 rdfs:domain obo:BFO_0000017 .
obo:BFO_0000054 rdfs:label "has realization"@en .
obo:BFO_0000054 rdfs:range obo:BFO_0000015 .
obo:BFO_0000054 skos:altLabel "realized in"@en .
obo:BFO_0000054 skos:definition "b has realization c =Def c realizes b"@en .
obo:BFO_0000054 skos:example "As for realizes"@en .

obo:BFO_0000055 <http://purl.org/dc/elements/1.1/identifier> "059-BFO" .
obo:BFO_0000055 rdf:type owl:ObjectProperty .
obo:BFO_0000055 rdfs:domain obo:BFO_0000015 .
obo:BFO_0000055 rdfs:label "realizes"@en .
obo:BFO_0000055 rdfs:range obo:BFO_0000017 .
obo:BFO_0000055 skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en .
obo:BFO_0000055 skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en .
obo:BFO_0000055 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000056 <http://purl.org/dc/elements/1.1/identifier> "250-BFO" .
obo:BFO_0000056 owl:inverseOf obo:BFO_0000057 .
obo:BFO_0000056 rdf:type owl:ObjectProperty .
obo:BFO_0000056 rdfs:label "participates in"@en .
obo:BFO_0000056 rdfs:range obo:BFO_0000015 .
obo:BFO_0000056 skos:definition "(Elucidation) participates in holds between some b that is either a specifically dependent continuant or generically dependent continuant or independent continuant that is not a spatial region & some process p such that b participates in p some way"@en .
obo:BFO_0000056 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000057 <http://purl.org/dc/elements/1.1/identifier> "248-BFO" .
obo:BFO_0000057 rdf:type owl:ObjectProperty .
obo:BFO_0000057 rdfs:domain obo:BFO_0000015 .
obo:BFO_0000057 rdfs:label "has participant"@en .
obo:BFO_0000057 skos:definition "p has participant c =Def c participates in p"@en .
obo:BFO_0000057 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000058 <http://purl.org/dc/elements/1.1/identifier> "258-BFO" .
obo:BFO_0000058 owl:inverseOf obo:BFO_0000059 .
obo:BFO_0000058 rdf:type owl:ObjectProperty .
obo:BFO_0000058 rdfs:domain obo:BFO_0000031 .
obo:BFO_0000058 rdfs:label "is concretized by"@en .
obo:BFO_0000058 skos:definition "c is concretized by b =Def b concretizes c"@en .
obo:BFO_0000058 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000059 <http://purl.org/dc/elements/1.1/identifier> "256-BFO" .
obo:BFO_0000059 rdf:type owl:ObjectProperty .
obo:BFO_0000059 rdfs:label "concretizes"@en .
obo:BFO_0000059 rdfs:range obo:BFO_0000031 .
obo:BFO_0000059 skos:definition "b concretizes c =Def b is a process or a specifically dependent continuant & c is a generically dependent continuant & there is some time t such that c is the pattern or content which b shares at t with actual or potential copies"@en .
obo:BFO_0000059 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000062 <http://purl.org/dc/elements/1.1/identifier> "213-BFO" .
obo:BFO_0000062 owl:inverseOf obo:BFO_0000063 .
obo:BFO_0000062 rdf:type owl:ObjectProperty .
obo:BFO_0000062 rdf:type owl:TransitiveProperty .
obo:BFO_0000062 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000062 rdfs:label "preceded by"@en .
obo:BFO_0000062 rdfs:range obo:BFO_0000003 .
obo:BFO_0000062 skos:definition "b preceded by c =Def b precedes c"@en .
obo:BFO_0000062 skos:example "The temporal region occupied by the second half of the match is preceded by the temporal region occupied by the first half of the match"@en .

obo:BFO_0000063 <http://purl.org/dc/elements/1.1/identifier> "270-BFO" .
obo:BFO_0000063 rdf:type owl:ObjectProperty .
obo:BFO_0000063 rdf:type owl:TransitiveProperty .
obo:BFO_0000063 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000063 rdfs:label "precedes"@en .
obo:BFO_0000063 rdfs:range obo:BFO_0000003 .
obo:BFO_0000063 skos:definition "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en .
obo:BFO_0000063 skos:example "The temporal region occupied by Mary's birth precedes the temporal region occupied by Mary's death."@en .
obo:BFO_0000063 skos:scopeNote "Each temporal region is its own temporal extent. The temporal extent of a spatiotemporal region is the temporal region it temporally projects onto. The temporal extent of a process or process boundary that occupies temporal region t is t." .
obo:BFO_0000063 skos:scopeNote "Precedes defines a strict partial order on occurrents." .

obo:BFO_0000066 <http://purl.org/dc/elements/1.1/identifier> "143-BFO" .
obo:BFO_0000066 owl:inverseOf obo:BFO_0000183 .
obo:BFO_0000066 rdf:type owl:ObjectProperty .
obo:BFO_0000066 rdfs:label "occurs in"@en .
obo:BFO_0000066 skos:definition "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en .
obo:BFO_0000066 skos:example "A process of digestion occurs in the interior of an organism; a process of loading artillery rounds into a tank cannon occurs in the interior of the tank"@en .

obo:BFO_0000084 <http://purl.org/dc/elements/1.1/identifier> "252-BFO" .
obo:BFO_0000084 owl:inverseOf obo:BFO_0000101 .
obo:BFO_0000084 rdf:type owl:ObjectProperty .
obo:BFO_0000084 rdfs:domain obo:BFO_0000031 .
obo:BFO_0000084 rdfs:label "generically depends on"@en .
obo:BFO_0000084 skos:altLabel "g-depends on"@en .
obo:BFO_0000084 skos:definition "b generically depends on c =Def b is a generically dependent continuant & c is an independent continuant that is not a spatial region & at some time t there inheres in c a specifically dependent continuant which concretizes b at t"@en .
obo:BFO_0000084 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000101 <http://purl.org/dc/elements/1.1/identifier> "254-BFO" .
obo:BFO_0000101 rdf:type owl:ObjectProperty .
obo:BFO_0000101 rdfs:label "is carrier of"@en .
obo:BFO_0000101 rdfs:range obo:BFO_0000031 .
obo:BFO_0000101 skos:definition "b is carrier of c =Def there is some time t such that c generically depends on b at t"@en .
obo:BFO_0000101 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000108 <http://purl.org/dc/elements/1.1/identifier> "118-BFO" .
obo:BFO_0000108 rdf:type owl:ObjectProperty .
obo:BFO_0000108 rdfs:domain obo:BFO_0000001 .
obo:BFO_0000108 rdfs:label "exists at"@en .
obo:BFO_0000108 rdfs:range obo:BFO_0000008 .
obo:BFO_0000108 skos:definition "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en .
obo:BFO_0000108 skos:example "First World War exists at 1914-1916; Mexico exists at January 1, 2000"@en .

obo:BFO_0000115 <http://purl.org/dc/elements/1.1/identifier> "230-BFO" .
obo:BFO_0000115 owl:inverseOf obo:BFO_0000129 .
obo:BFO_0000115 rdf:type owl:ObjectProperty .
obo:BFO_0000115 rdfs:domain obo:BFO_0000040 .
obo:BFO_0000115 rdfs:label "has member part"@en .
obo:BFO_0000115 rdfs:range obo:BFO_0000040 .
obo:BFO_0000115 rdfs:subPropertyOf obo:BFO_0000178 .
obo:BFO_0000115 skos:definition "b has member part c =Def c member part of b"@en .
obo:BFO_0000115 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000117 <http://purl.org/dc/elements/1.1/identifier> "202-BFO" .
obo:BFO_0000117 owl:inverseOf obo:BFO_0000132 .
obo:BFO_0000117 rdf:type owl:ObjectProperty .
obo:BFO_0000117 rdf:type owl:TransitiveProperty .
obo:BFO_0000117 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000117 rdfs:label "has occurrent part"@en .
obo:BFO_0000117 rdfs:range obo:BFO_0000003 .
obo:BFO_0000117 skos:definition "b has occurrent part c =Def c occurrent part of b"@en .
obo:BFO_0000117 skos:example "Mary's life has occurrent part Mary's 5th birthday"@en .

obo:BFO_0000121 <http://purl.org/dc/elements/1.1/identifier> "211-BFO" .
obo:BFO_0000121 owl:inverseOf obo:BFO_0000139 .
obo:BFO_0000121 rdf:type owl:ObjectProperty .
obo:BFO_0000121 rdf:type owl:TransitiveProperty .
obo:BFO_0000121 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000121 rdfs:label "has temporal part"@en .
obo:BFO_0000121 rdfs:range obo:BFO_0000003 .
obo:BFO_0000121 rdfs:subPropertyOf obo:BFO_0000117 .
obo:BFO_0000121 skos:definition "b has temporal part c =Def c temporal part of b"@en .
obo:BFO_0000121 skos:example "Your life has temporal part the first year of your life"@en .

obo:BFO_0000124 <http://purl.org/dc/elements/1.1/identifier> "236-BFO" .
obo:BFO_0000124 owl:inverseOf obo:BFO_0000171 .
obo:BFO_0000124 rdf:type owl:ObjectProperty .
obo:BFO_0000124 rdfs:label "location of"@en .
obo:BFO_0000124 skos:definition "b location of c =Def c located in b"@en .
obo:BFO_0000124 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000127 <http://purl.org/dc/elements/1.1/identifier> "244-BFO" .
obo:BFO_0000127 owl:inverseOf obo:BFO_0000218 .
obo:BFO_0000127 rdf:type owl:ObjectProperty .
obo:BFO_0000127 rdfs:domain obo:BFO_0000040 .
obo:BFO_0000127 rdfs:label "material basis of"@en .
obo:BFO_0000127 rdfs:range obo:BFO_0000016 .
obo:BFO_0000127 skos:definition "b material basis of c =Def c has material basis b"@en .
obo:BFO_0000127 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000129 <http://purl.org/dc/elements/1.1/identifier> "228-BFO" .
obo:BFO_0000129 rdf:type owl:ObjectProperty .
obo:BFO_0000129 rdfs:domain obo:BFO_0000040 .
obo:BFO_0000129 rdfs:label "member part of"@en .
obo:BFO_0000129 rdfs:range obo:BFO_0000040 .
obo:BFO_0000129 rdfs:subPropertyOf obo:BFO_0000176 .
obo:BFO_0000129 skos:definition "b member part of c =Def b is an object & c is a material entity & there is some time t such that b continuant part of c at t & there is a mutually exhaustive and pairwise disjoint partition of c into objects x1, ..., xn (for some n ≠ 1) with b = xi (for some 1 <= i <= n)"@en .
obo:BFO_0000129 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000132 <http://purl.org/dc/elements/1.1/identifier> "003-BFO" .
obo:BFO_0000132 rdf:type owl:ObjectProperty .
obo:BFO_0000132 rdf:type owl:TransitiveProperty .
obo:BFO_0000132 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000132 rdfs:label "occurrent part of"@en .
obo:BFO_0000132 rdfs:range obo:BFO_0000003 .
obo:BFO_0000132 skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en .
obo:BFO_0000132 skos:example "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en .

obo:BFO_0000139 <http://purl.org/dc/elements/1.1/identifier> "078-BFO" .
obo:BFO_0000139 rdf:type owl:ObjectProperty .
obo:BFO_0000139 rdf:type owl:TransitiveProperty .
obo:BFO_0000139 rdfs:domain obo:BFO_0000003 .
obo:BFO_0000139 rdfs:label "temporal part of"@en .
obo:BFO_0000139 rdfs:range obo:BFO_0000003 .
obo:BFO_0000139 rdfs:subPropertyOf obo:BFO_0000132 .
obo:BFO_0000139 skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en .
obo:BFO_0000139 skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en .

obo:BFO_0000140 <http://purl.org/dc/elements/1.1/identifier> "029-BFO" .
obo:BFO_0000140 rdf:type owl:Class .
obo:BFO_0000140 rdfs:label "continuant fiat boundary"@en .
obo:BFO_0000140 rdfs:subClassOf obo:BFO_0000141 .
obo:BFO_0000140 skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en .
obo:BFO_0000140 skos:example "As for fiat point, fiat line, fiat surface"@en .

obo:BFO_0000141 <http://purl.org/dc/elements/1.1/identifier> "028-BFO" .
obo:BFO_0000141 rdf:type owl:Class .
obo:BFO_0000141 rdfs:label "immaterial entity"@en .
obo:BFO_0000141 rdfs:subClassOf obo:BFO_0000004 .
obo:BFO_0000141 skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en .
obo:BFO_0000141 skos:example "As for fiat point, fiat line, fiat surface, site"@en .

obo:BFO_0000142 <http://purl.org/dc/elements/1.1/identifier> "032-BFO" .
obo:BFO_0000142 rdf:type owl:Class .
obo:BFO_0000142 rdfs:label "fiat line"@en .
obo:BFO_0000142 rdfs:subClassOf obo:BFO_0000140 .
obo:BFO_0000142 skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en .
obo:BFO_0000142 skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en .

obo:BFO_0000145 <http://purl.org/dc/elements/1.1/identifier> "057-BFO" .
obo:BFO_0000145 rdf:type owl:Class .
obo:BFO_0000145 rdfs:label "relational quality"@en .
obo:BFO_0000145 rdfs:subClassOf obo:BFO_0000019 .
obo:BFO_0000145 skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en .
obo:BFO_0000145 skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .

obo:BFO_0000146 <http://purl.org/dc/elements/1.1/identifier> "033-BFO" .
obo:BFO_0000146 rdf:type owl:Class .
obo:BFO_0000146 rdfs:label "fiat surface"@en .
obo:BFO_0000146 rdfs:subClassOf obo:BFO_0000140 .
obo:BFO_0000146 skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en .
obo:BFO_0000146 skos:example "The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant"@en .

obo:BFO_0000147 <http://purl.org/dc/elements/1.1/identifier> "031-BFO" .
obo:BFO_0000147 rdf:type owl:Class .
obo:BFO_0000147 rdfs:label "fiat point"@en .
obo:BFO_0000147 rdfs:subClassOf obo:BFO_0000140 .
obo:BFO_0000147 skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en .
obo:BFO_0000147 skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en .

obo:BFO_0000148 <http://purl.org/dc/elements/1.1/identifier> "102-BFO" .
obo:BFO_0000148 rdf:type owl:Class .
obo:BFO_0000148 rdfs:label "zero-dimensional temporal region"@en .
obo:BFO_0000148 rdfs:subClassOf obo:BFO_0000008 .
obo:BFO_0000148 skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en .
obo:BFO_0000148 skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en .

obo:BFO_0000153 <http://purl.org/dc/elements/1.1/identifier> "080-BFO" .
obo:BFO_0000153 rdf:type owl:FunctionalProperty .
obo:BFO_0000153 rdf:type owl:ObjectProperty .
obo:BFO_0000153 rdfs:domain obo:BFO_0000011 .
obo:BFO_0000153 rdfs:label "temporally projects onto"@en .
obo:BFO_0000153 rdfs:range obo:BFO_0000008 .
obo:BFO_0000153 skos:definition "(Elucidation) temporally projects onto is a relation between a spatiotemporal region s and some temporal region which is the temporal extent of s"@en .
obo:BFO_0000153 skos:example "The world line of a particle temporally projects onto the temporal region extending from the beginning to the end of the existence of the particle"@en .

obo:BFO_0000171 <http://purl.org/dc/elements/1.1/identifier> "234-BFO" .
obo:BFO_0000171 rdf:type owl:ObjectProperty .
obo:BFO_0000171 rdfs:label "located in"@en .
obo:BFO_0000171 skos:definition "b located in c =Def b is an independent continuant & c is an independent & neither is a spatial region & there is some time t such that the spatial region which b occupies at t is continuant part of the spatial region which c occupies at t"@en .
obo:BFO_0000171 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000176 <http://purl.org/dc/elements/1.1/identifier> "221-BFO" .
obo:BFO_0000176 owl:inverseOf obo:BFO_0000178 .
obo:BFO_0000176 rdf:type owl:ObjectProperty .
obo:BFO_0000176 rdfs:domain obo:BFO_0000002 .
obo:BFO_0000176 rdfs:label "continuant part of"@en .
obo:BFO_0000176 rdfs:range obo:BFO_0000002 .
obo:BFO_0000176 skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b continuant part of c at t"@en .
obo:BFO_0000176 skos:example "Milk teeth continuant part of human; surgically removed tumour continuant part of organism"@en .
obo:BFO_0000176 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000178 <http://purl.org/dc/elements/1.1/identifier> "271-BFO" .
obo:BFO_0000178 rdf:type owl:ObjectProperty .
obo:BFO_0000178 rdfs:domain obo:BFO_0000002 .
obo:BFO_0000178 rdfs:label "has continuant part"@en .
obo:BFO_0000178 rdfs:range obo:BFO_0000002 .
obo:BFO_0000178 skos:definition "b has continuant part c =Def c continuant part of b"@en .
obo:BFO_0000178 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000182 <http://purl.org/dc/elements/1.1/identifier> "138-BFO" .
obo:BFO_0000182 rdf:type owl:Class .
obo:BFO_0000182 rdfs:label "history"@en .
obo:BFO_0000182 rdfs:subClassOf obo:BFO_0000015 .
obo:BFO_0000182 skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en .
obo:BFO_0000182 skos:example "The life of an organism from the beginning to the end of its existence"@en .

obo:BFO_0000183 <http://purl.org/dc/elements/1.1/identifier> "267-BFO" .
obo:BFO_0000183 rdf:type owl:ObjectProperty .
obo:BFO_0000183 rdfs:label "environs"@en .
obo:BFO_0000183 skos:altLabel "contains process"@en .
obo:BFO_0000183 skos:definition "b environs c =Def c occurs in b"@en .
obo:BFO_0000183 skos:example "Mouth environs process of mastication; city environs traffic"@en .

obo:BFO_0000184 <http://purl.org/dc/elements/1.1/identifier> "144-BFO" .
obo:BFO_0000184 owl:inverseOf obo:BFO_0000185 .
obo:BFO_0000184 rdf:type owl:FunctionalProperty .
obo:BFO_0000184 rdf:type owl:InverseFunctionalProperty .
obo:BFO_0000184 rdf:type owl:ObjectProperty .
obo:BFO_0000184 rdfs:domain obo:BFO_0000182 .
obo:BFO_0000184 rdfs:label "history of"@en .
obo:BFO_0000184 rdfs:range obo:BFO_0000040 .
obo:BFO_0000184 skos:definition "(Elucidation) history of is a relation between history b and material entity c such that b is the unique history of c"@en .
obo:BFO_0000184 skos:example "This life is the history of this organism"@en .

obo:BFO_0000185 <http://purl.org/dc/elements/1.1/identifier> "145-BFO" .
obo:BFO_0000185 rdf:type owl:ObjectProperty .
obo:BFO_0000185 rdfs:domain obo:BFO_0000040 .
obo:BFO_0000185 rdfs:label "has history"@en .
obo:BFO_0000185 rdfs:range obo:BFO_0000182 .
obo:BFO_0000185 skos:definition "b has history c =Def c history of b"@en .
obo:BFO_0000185 skos:example "This organism has history this life"@en .

obo:BFO_0000194 <http://purl.org/dc/elements/1.1/identifier> "260-BFO" .
obo:BFO_0000194 owl:inverseOf obo:BFO_0000195 .
obo:BFO_0000194 rdf:type owl:ObjectProperty .
obo:BFO_0000194 rdfs:label "specifically depended on by"@en .
obo:BFO_0000194 rdfs:range obo:BFO_0000020 .
obo:BFO_0000194 skos:altLabel "s-depended on by"@en .
obo:BFO_0000194 skos:definition "b specifically depended on by c =Def c specifically depends on b"@en .
obo:BFO_0000194 skos:example "Coloured object specifically depended on by colour"@en .

obo:BFO_0000195 <http://purl.org/dc/elements/1.1/identifier> "012-BFO" .
obo:BFO_0000195 rdf:type owl:ObjectProperty .
obo:BFO_0000195 rdfs:domain obo:BFO_0000020 .
obo:BFO_0000195 rdfs:label "specifically depends on"@en .
obo:BFO_0000195 skos:altLabel "s-depends on"@en .
obo:BFO_0000195 skos:definition "(Elucidation) specifically depends on is a relation between a specifically dependent continuant b and specifically dependent continuant or independent continuant that is not a spatial region c such that b and c share no parts in common & b is of a nature such that at all times t it cannot exist unless c exists & b is not a boundary of c"@en .
obo:BFO_0000195 skos:example "A shape specifically depends on the shaped object; hue, saturation and brightness of a colour sample specifically depends on each other"@en .
obo:BFO_0000195 skos:scopeNote "The analogue of specifically depends on for occurrents is has participant."@en .

obo:BFO_0000196 <http://purl.org/dc/elements/1.1/identifier> "053-BFO" .
obo:BFO_0000196 owl:inverseOf obo:BFO_0000197 .
obo:BFO_0000196 rdf:type owl:ObjectProperty .
obo:BFO_0000196 rdfs:label "bearer of"@en .
obo:BFO_0000196 rdfs:range obo:BFO_0000020 .
obo:BFO_0000196 rdfs:subPropertyOf obo:BFO_0000194 .
obo:BFO_0000196 skos:definition "b bearer of c =Def c inheres in b"@en .
obo:BFO_0000196 skos:example "A patch of ink is the bearer of a colour quality; an organism is the bearer of a temperature quality"@en .

obo:BFO_0000197 <http://purl.org/dc/elements/1.1/identifier> "051-BFO" .
obo:BFO_0000197 rdf:type owl:ObjectProperty .
obo:BFO_0000197 rdfs:domain obo:BFO_0000020 .
obo:BFO_0000197 rdfs:label "inheres in"@en .
obo:BFO_0000197 rdfs:subPropertyOf obo:BFO_0000195 .
obo:BFO_0000197 skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en .
obo:BFO_0000197 skos:example "A shape inheres in a shaped object; a mass inheres in a material entity"@en .

obo:BFO_0000199 <http://purl.org/dc/elements/1.1/identifier> "132-BFO" .
obo:BFO_0000199 rdf:type owl:FunctionalProperty .
obo:BFO_0000199 rdf:type owl:ObjectProperty .
obo:BFO_0000199 rdfs:label "occupies temporal region"@en .
obo:BFO_0000199 rdfs:range obo:BFO_0000008 .
obo:BFO_0000199 skos:definition "p occupies temporal region t =Def p is a process or process boundary & the spatiotemporal region occupied by p temporally projects onto t"@en .
obo:BFO_0000199 skos:example "The Second World War occupies the temporal region September 1, 1939 - September 2, 1945"@en .

obo:BFO_0000200 <http://purl.org/dc/elements/1.1/identifier> "082-BFO" .
obo:BFO_0000200 rdf:type owl:FunctionalProperty .
obo:BFO_0000200 rdf:type owl:ObjectProperty .
obo:BFO_0000200 rdfs:label "occupies spatiotemporal region"@en .
obo:BFO_0000200 rdfs:range obo:BFO_0000011 .
obo:BFO_0000200 skos:definition "(Elucidation) occupies spatiotemporal region is a relation between a process or process boundary p and the spatiotemporal region s which is its spatiotemporal extent"@en .
obo:BFO_0000200 skos:example "A particle emitted by a nuclear reactor occupies the spatiotemporal region which is its trajectory"@en .

obo:BFO_0000202 <http://purl.org/dc/elements/1.1/identifier> "155-BFO" .
obo:BFO_0000202 rdf:type owl:Class .
obo:BFO_0000202 rdfs:label "temporal interval"@en .
obo:BFO_0000202 rdfs:subClassOf obo:BFO_0000038 .
obo:BFO_0000202 skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en .
obo:BFO_0000202 skos:example "The year 2018."@en .
obo:BFO_0000202 skos:scopeNote "A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps."@en .

obo:BFO_0000203 <http://purl.org/dc/elements/1.1/identifier> "209-BFO" .
obo:BFO_0000203 rdf:type owl:Class .
obo:BFO_0000203 rdfs:label "temporal instant"@en .
obo:BFO_0000203 rdfs:subClassOf obo:BFO_0000148 .
obo:BFO_0000203 skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en .
obo:BFO_0000203 skos:example "The millennium"@en .

obo:BFO_0000210 <http://purl.org/dc/elements/1.1/identifier> "232-BFO" .
obo:BFO_0000210 rdf:type owl:ObjectProperty .
obo:BFO_0000210 rdfs:label "occupies spatial region"@en .
obo:BFO_0000210 rdfs:range obo:BFO_0000006 .
obo:BFO_0000210 skos:definition "b occupies spatial region r =Def b is an independent continuant that is not a spatial region & r is a spatial region & there is some time t such that every continuant part of b occupies some continuant part of r at t and no continuant part of b occupies any spatial region that is not a continuant part of r at t"@en .
obo:BFO_0000210 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000216 <http://purl.org/dc/elements/1.1/identifier> "246-BFO" .
obo:BFO_0000216 rdf:type owl:ObjectProperty .
obo:BFO_0000216 rdfs:domain obo:BFO_0000011 .
obo:BFO_0000216 rdfs:label "spatially projects onto"@en .
obo:BFO_0000216 rdfs:range obo:BFO_0000006 .
obo:BFO_0000216 skos:definition "(Elucidation) spatially projects onto is a relation between some spatiotemporal region b and spatial region c such that at some time t, c is the spatial extent of b at t"@en .
obo:BFO_0000216 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000218 <http://purl.org/dc/elements/1.1/identifier> "242-BFO" .
obo:BFO_0000218 rdf:type owl:ObjectProperty .
obo:BFO_0000218 rdfs:domain obo:BFO_0000016 .
obo:BFO_0000218 rdfs:label "has material basis"@en .
obo:BFO_0000218 rdfs:range obo:BFO_0000040 .
obo:BFO_0000218 skos:definition "b has material basis c =Def b is a disposition & c is a material entity & there is some d bearer of b & there is some time t such that c is a continuant part of d at t & d has disposition b because c is a continuant part of d at t"@en .
obo:BFO_0000218 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <Link>"@en .

obo:BFO_0000221 <http://purl.org/dc/elements/1.1/identifier> "268-BFO" .
obo:BFO_0000221 owl:inverseOf obo:BFO_0000222 .
obo:BFO_0000221 rdf:type owl:ObjectProperty .
obo:BFO_0000221 rdfs:domain obo:BFO_0000203 .
obo:BFO_0000221 rdfs:label "first instant of"@en .
obo:BFO_0000221 rdfs:range obo:BFO_0000008 .
obo:BFO_0000221 skos:definition "t first instant of t' =Def t is a temporal instant & t' is a temporal region t' & t precedes all temporal parts of t' other than t"@en .
obo:BFO_0000221 skos:example "An hour starting at midnight yesterday has first instant midnight yesterday"@en .

obo:BFO_0000222 <http://purl.org/dc/elements/1.1/identifier> "261-BFO" .
obo:BFO_0000222 rdf:type owl:FunctionalProperty .
obo:BFO_0000222 rdf:type owl:ObjectProperty .
obo:BFO_0000222 rdfs:domain obo:BFO_0000008 .
obo:BFO_0000222 rdfs:label "has first instant"@en .
obo:BFO_0000222 rdfs:range obo:BFO_0000203 .
obo:BFO_0000222 skos:definition "t has first instant t' =Def t' first instant of t"@en .
obo:BFO_0000222 skos:example "The first hour of a year has first instant midnight on December 31"@en .

obo:BFO_0000223 <http://purl.org/dc/elements/1.1/identifier> "269-BFO" .
obo:BFO_0000223 owl:inverseOf obo:BFO_0000224 .
obo:BFO_0000223 rdf:type owl:ObjectProperty .
obo:BFO_0000223 rdfs:domain obo:BFO_0000203 .
obo:BFO_0000223 rdfs:label "last instant of"@en .
obo:BFO_0000223 rdfs:range obo:BFO_0000008 .
obo:BFO_0000223 skos:definition "t last instant of t' =Def t is a temporal instant & t' is a temporal region & all temporal parts of t' other than t precede t"@en .
obo:BFO_0000223 skos:example "Last midnight is the last instant of yesterday"@en .

obo:BFO_0000224 <http://purl.org/dc/elements/1.1/identifier> "215-BFO" .
obo:BFO_0000224 rdf:type owl:FunctionalProperty .
obo:BFO_0000224 rdf:type owl:ObjectProperty .
obo:BFO_0000224 rdfs:domain obo:BFO_0000008 .
obo:BFO_0000224 rdfs:label "has last instant"@en .
obo:BFO_0000224 rdfs:range obo:BFO_0000203 .
obo:BFO_0000224 skos:definition "t has last instant t' =Def t' last instant of t"@en .
obo:BFO_0000224 skos:example "The last hour of a year has last instant midnight December 31"@en .
